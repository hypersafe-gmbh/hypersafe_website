---
import Container from './Container.astro';
import Eyes from './Eyes.astro';
import { TALLY_URL } from '../data/links';
---

<section id="hero">
  <Container>
    <div class="grid items-center gap-12 py-16 md:grid-cols-[1.25fr_1fr] md:py-24">
      <div>
        <h1
          class="rise text-[2.5rem] font-medium leading-[0.98] tracking-[-0.04em] md:text-[3.875rem]"
        >
          We <mark class="rounded-lg bg-lime px-2 text-ink">break</mark> your product before someone else does.
        </h1>
        <p class="rise d1 mt-6 max-w-xl text-lg leading-relaxed text-zinc-800">
          <b class="font-semibold text-ink">HyperSafe is a security consulting and engineering firm in Geneva.</b>
          We audit code and infrastructure, pentest apps, and help you fix what we find. Specialised in Web3 and AI security.
        </p>
        <div class="rise d2 mt-8 flex flex-wrap gap-3">
          <a
            href={TALLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-2xl bg-ink px-6 py-3.5 text-white hover:bg-stone"
          >
            Let's talk
          </a>
          <a
            href="#services"
            class="rounded-2xl border border-ink px-6 py-3.5 hover:bg-ink hover:text-white"
          >
            Our services
          </a>
        </div>
      </div>
      <Eyes />
    </div>
  </Container>
</section>
