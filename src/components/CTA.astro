---
import Container from './Container.astro';
import { TALLY_URL } from '../data/links';
---

<section id="cta" class="pb-10">
  <Container>
    <div
      class="flex flex-col items-start justify-between gap-6 rounded-[36px] bg-stone p-8 text-white md:flex-row md:items-center md:p-11"
    >
      <div>
        <p class="text-3xl font-medium tracking-[-0.03em] md:text-[2.125rem]">Let's make things happen</p>
        <p class="mt-1.5 text-zinc-600">Let us know how we can help.</p>
      </div>
      <a
        href={TALLY_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-2xl bg-lime px-6 py-3.5 text-ink hover:bg-white"
      >
        Heck yeah, let's talk →
      </a>
    </div>
  </Container>
</section>
