---
import Container from './Container.astro';
import { serviceGroups } from '../data/services';

const tones = {
  light: 'bg-card-light',
  dark: 'bg-stone text-white',
  lime: 'bg-lime',
};
---

<section id="services" class="pt-16 md:pt-20">
  <Container>
    <h2 class="mb-2 text-3xl font-medium tracking-[-0.035em] md:text-[2.5rem]">What we do</h2>
    <p class="mb-8 max-w-2xl text-zinc-800">
      Security is the core of what we do. We also build software and infrastructure, secure by default.
    </p>
    <div class="space-y-8">
      {
        serviceGroups.map((group) => (
          <div class="grid gap-4 md:grid-cols-[180px_1fr] md:gap-5">
            <div class="pt-1.5">
              <h3 class="text-[1.375rem] font-medium tracking-[-0.02em]">{group.name}</h3>
              <p class="mt-1 text-xs text-muted">{group.tag}</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              {group.services.map((service) => (
                <div
                  class:list={[
                    'card-lift flex min-h-[150px] flex-col justify-between rounded-[28px] border border-ink p-6 shadow-[0_4px_0_#141414]',
                    tones[service.tone],
                  ]}
                >
                  <div>
                    <h4 class="text-[1.375rem] font-medium leading-tight tracking-[-0.02em]">{service.title}</h4>
                    <p class="mt-2 text-sm leading-relaxed opacity-75">{service.text}</p>
                  </div>
                  <div class="mt-4 flex justify-end" aria-hidden="true">
                    <span
                      class:list={[
                        'grid h-8 w-8 place-items-center rounded-full text-sm',
                        service.tone === 'dark' ? 'bg-white text-ink' : 'bg-ink text-lime',
                      ]}
                    >
                      ↗
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
