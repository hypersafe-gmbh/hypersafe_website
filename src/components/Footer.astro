---
import Container from './Container.astro';
import { EMAIL } from '../data/links';

const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-zinc-200">
  <Container>
    <div class="flex flex-col items-center justify-between gap-3 py-6 text-sm text-zinc-700 md:flex-row">
      <img class="h-5" src="/logo.svg" alt="HyperSafe" />
      <div class="flex flex-col items-center gap-x-6 gap-y-1 md:flex-row">
        <a href={`mailto:${EMAIL}`} class="hover:text-ink">{EMAIL}</a>
        <span>© {year} HyperSafe GmbH · Geneva, Switzerland</span>
      </div>
    </div>
  </Container>
</footer>
