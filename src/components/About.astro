---
import Container from './Container.astro';
---

<section id="about" class="py-16 md:py-20">
  <Container>
    <div class="grid items-center gap-8 md:grid-cols-2">
      <div>
        <p class="mb-3 text-xs uppercase tracking-[0.14em] text-muted">About</p>
        <h2 class="mb-3 text-3xl font-medium tracking-[-0.035em] md:text-[2.5rem]">Headquartered in Geneva 🇨🇭</h2>
        <p class="text-zinc-800">HyperSafe GmbH, Geneva. Founded by Valentin Quelquejay.</p>
      </div>
      <div
        class="flex items-center gap-5 rounded-[36px] border border-ink bg-white px-6 py-5 shadow-[0_4px_0_#141414] md:justify-self-end"
      >
        <img class="h-[92px] w-[92px] rounded-full object-cover" src="/img/val.png" alt="" />
        <div>
          <p class="text-lg font-medium">Valentin Quelquejay</p>
          <p class="text-sm text-zinc-700">Founder</p>
        </div>
      </div>
    </div>
  </Container>
</section>
