---
import Container from './Container.astro';
import { TALLY_URL } from '../data/links';

const navLinks = [
  { href: '/#services', label: 'Services' },
  { href: '/#about', label: 'About' },
];
---

<nav class="sticky top-0 z-50 w-full border-b border-zinc-200 bg-page/90 backdrop-blur">
  <Container>
    <div class="flex flex-wrap items-center justify-between py-4">
      <a href="/" class="flex items-center">
        <img src="/logo.svg" class="h-7" alt="HyperSafe" />
      </a>
      <div class="flex items-center gap-2 md:order-2">
        <a
          href={TALLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl bg-ink px-4 py-2 text-sm text-white hover:bg-stone"
        >
          Let's talk
        </a>
        <button
          data-collapse-toggle="navbar-default"
          type="button"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg p-2 text-sm focus:outline-none focus:ring-2 md:hidden"
          aria-controls="navbar-default"
          aria-expanded="false"
        >
          <span class="sr-only" data-menu-label>Open main menu</span>
          <svg class="h-5 w-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"></path>
          </svg>
        </button>
      </div>
      <div class="hidden w-full md:order-1 md:ml-auto md:mr-8 md:block md:w-auto" id="navbar-default">
        <ul class="mt-4 flex flex-col gap-1 text-sm md:mt-0 md:flex-row md:gap-8">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class="block py-2 hover:text-muted md:py-0">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</nav>

<script>
  const navbar = document.getElementById('navbar-default');
  const toggleButton = document.querySelector('[data-collapse-toggle="navbar-default"]');

  const label = toggleButton?.querySelector('[data-menu-label]');

  const setOpen = (open: boolean) => {
    navbar?.classList.toggle('hidden', !open);
    toggleButton?.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'Close main menu' : 'Open main menu';
  };

  if (navbar && toggleButton) {
    toggleButton.addEventListener('click', () => setOpen(navbar.classList.contains('hidden')));
    navbar.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  }
</script>
