<div class="eyes" aria-hidden="true">
  <div class="eye"><div class="pupil"></div></div>
  <div class="eye"><div class="pupil"></div></div>
</div>

<style>
  .eyes {
    display: flex;
    justify-content: center;
    gap: 16px;
  }
  .eye {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: #d4d1cf;
    animation: blink 5s infinite;
  }
  .pupil {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #141414;
    transition: transform 0.12s;
  }
  @media (min-width: 768px) {
    .eyes {
      gap: 20px;
    }
    .eye {
      width: 140px;
      height: 140px;
    }
    .pupil {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  if (
    matchMedia('(hover: hover)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const pupils = document.querySelectorAll<HTMLElement>('.eyes .pupil');

    document.addEventListener('mousemove', (e) => {
      pupils.forEach((pupil) => {
        const eye = pupil.parentElement!.getBoundingClientRect();
        const cx = eye.left + eye.width / 2;
        const cy = eye.top + eye.height / 2;
        const maxOffset = eye.width / 2 - pupil.offsetWidth / 2 - 4;
        const angle = Math.atan2(e.clientY - cy, e.clientX - cx);
        const distance = Math.min(maxOffset, Math.hypot(e.clientX - cx, e.clientY - cy) / 8);
        pupil.style.transform = `translate(${Math.cos(angle) * distance}px, ${Math.sin(angle) * distance}px)`;
      });
    });
  }
</script>
